<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.research-pipeline.worker</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/research-pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/research-pipeline/.venv/bin/python</string>
    <string>/Users/YOUR_USER/research-pipeline/main.py</string>
    <string>worker</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/research-pipeline/logs/worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/research-pipeline/logs/worker.err.log</string>
</dict>
</plist>
