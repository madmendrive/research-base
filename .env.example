# Secrets
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Optional data/API keys
EDINET_API_KEY=
DART_API_KEY=

# Ingestion/extraction
TRIAGE_PROVIDER=openai
TRIAGE_MODEL=gpt-5-mini
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5-mini

# Analyst synthesis
ANALYST_PROVIDER=anthropic
ANALYST_MODEL=claude-opus-4-7
ANALYST_TIMEOUT=120
ANALYST_PROVIDER_MAX_RETRIES=0
ANALYST_FALLBACK_PROVIDER=openai
ANALYST_FALLBACK_MODEL=gpt-5.5
ANALYST_OPENAI_REASONING_EFFORT=high

# Fast path for source-constrained KB questions, e.g. "according to JPM"
BOT_ANALYST_TIMEOUT=150
ANALYST_STRUCTURED_PROVIDER=anthropic
ANALYST_STRUCTURED_MODEL=gpt-5.5
ANALYST_STRUCTURED_OPENAI_MODEL=gpt-5.5
ANALYST_STRUCTURED_ANTHROPIC_MODEL=claude-opus-4-7
ANALYST_STRUCTURED_TIMEOUT=60
ANALYST_STRUCTURED_MAX_RETRIES=0
ANALYST_STRUCTURED_REASONING_EFFORT=high
ANALYST_STRUCTURED_MAX_TOKENS=3000

# Optional live web context for analyst answers
ANALYST_WEB_CONTEXT=auto
ANALYST_WEB_PROVIDER=openai
ANALYST_WEB_MODEL=gpt-5-mini
ANALYST_WEB_MAX_USES=4
ANALYST_WEB_LIVE=1

# Research email inbox sweep
# Preferred: Gmail API OAuth. Download a Google Desktop OAuth client JSON to
# config/gmail_oauth_client_secret.json, then run: python main.py gmail-auth
RESEARCH_EMAIL_PROVIDER=gmail_api
GMAIL_OAUTH_CLIENT_SECRET=config/gmail_oauth_client_secret.json
GMAIL_OAUTH_TOKEN=data/_secrets/gmail_token.json
GMAIL_QUERY=in:inbox

# Optional fallback: IMAP app-password mode.
# RESEARCH_EMAIL_PROVIDER=imap
# RESEARCH_IMAP_HOST=imap.gmail.com
# RESEARCH_IMAP_PORT=993
# RESEARCH_IMAP_USERNAME=
# RESEARCH_IMAP_PASSWORD=
# RESEARCH_IMAP_MAILBOX=INBOX

# Overnight study agent
STUDY_PROVIDER=anthropic
STUDY_MODEL=claude-opus-4-7
STUDY_INPUT_COST_PER_MTOK=15
STUDY_OUTPUT_COST_PER_MTOK=75
STUDY_OPENAI_REASONING_EFFORT=high

# KB synthesis / embeddings
KB_SYNTHESIS_MODEL=claude-opus-4-7
KB_EMBEDDING_PROVIDER=openai
KB_EMBEDDING_MODEL=text-embedding-3-small

# Research extraction reads PDFs natively (text + tables/charts/exhibits) via
# Claude document blocks when the PDF is <=100 pages / <=30MB. Set to 0 to
# fall back to pdfplumber text-only extraction (cheaper, loses exhibits).
PDF_NATIVE_EXTRACTION=1
# Hard ceiling on extracted text sent to structured extraction (characters).
EXTRACT_MAX_CHARS=400000
